{
  "name": "patina",
  "private": true,
  "version": "1.10.0",
  "type": "module",
  "engines": {
    "node": "24.22.1",
    "pnpm": "12.15.0"
  },
  "scripts": {
    "test:release": "node --experimental-strip-types --experimental-specifier-resolution=node tests/releasePolicy.test.ts && node --experimental-strip-types tests/nativeRelease.test.ts",
    "test:pr-intake": "node --experimental-strip-types --experimental-specifier-resolution=node tests/prIntakeGate.test.ts",
    "test:dependency-audit": "node --experimental-strip-types tests/dependencyAudit.test.ts",
    "i18n:generate": "node --experimental-strip-types scripts/i18n/generate.ts --write",
    "i18n:new": "node --experimental-strip-types scripts/i18n/new-locale.ts",
    "i18n:review": "node --experimental-strip-types scripts/i18n/review-locale.ts",
    "i18n:export-kit": "node --experimental-strip-types scripts/i18n/export-translation-kit.ts",
    "i18n:import-kit": "node --experimental-strip-types scripts/i18n/import-translation-kit.ts",
    "check:docs": "node --experimental-strip-types scripts/check-doc-governance.ts",
    "check:docs:self-test": "node --experimental-strip-types scripts/check-doc-governance.ts --self-test",
    "check:pr-intake": "node --experimental-strip-types scripts/check-pr-intake.ts",
    "check:dependencies": "node --experimental-strip-types scripts/audit-dependencies.ts",
    "release:sync-version": "node --experimental-strip-types scripts/release.ts sync-version",
    "release:validate-version-files": "node --experimental-strip-types scripts/release.ts validate-version-files",
    "release:validate-changelog": "node --experimental-strip-types scripts/release.ts validate-changelog",
    "release:notes": "node --experimental-strip-types scripts/release.ts print-release-notes",
    "release:mirror-manifest": "node --experimental-strip-types scripts/native-release.ts mirror",
    "release:prepare-assets": "node --experimental-strip-types scripts/native-release.ts prepare",
    "release:verify-assets": "node --experimental-strip-types scripts/native-release.ts verify",
    "release:check": "pnpm run check:full && pnpm run release:validate-changelog",
    "preinstall": "node --experimental-strip-types scripts/check-toolchain.ts",
    "check:toolchain": "node --experimental-strip-types scripts/check-toolchain.ts",
    "dev": "cargo run --locked",
    "build": "cd desktop && cargo build --locked -p patina-gpui",
    "test": "pnpm run test:i18n && pnpm run test:release && pnpm run test:pr-intake && pnpm run test:dependency-audit",
    "test:i18n": "node --experimental-strip-types tests/i18nTranslationKit.test.ts",
    "check:i18n": "node --experimental-strip-types scripts/i18n/check.ts && node --experimental-strip-types scripts/i18n/check-hardcoded.ts",
    "check:i18n:self-test": "node --experimental-strip-types scripts/i18n/check.ts --self-test && node --experimental-strip-types scripts/i18n/new-locale.ts --self-test",
    "check:types": "tsc --noEmit",
    "check": "pnpm run check:toolchain && pnpm run check:i18n:self-test && pnpm run check:i18n && pnpm run check:docs:self-test && pnpm run check:docs && pnpm run check:types && pnpm test",
    "check:rust": "cd desktop && cargo fmt --all -- --check && cargo test-headless --locked && cargo clippy --locked --workspace --all-targets --all-features -- -D warnings",
    "check:full": "pnpm run check && pnpm run check:rust && pnpm run check:dependencies",
    "perf:resources": "cd desktop && cargo run --locked -p patina-gpui --example windows-resource-sample --"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "exceljs": "^4.4.0",
    "saxes": "^6.0.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@12.15.0"
}
