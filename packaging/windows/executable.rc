#include <winver.h>
#define STRING_VALUE_(x) #x
#define STRING_VALUE(x) STRING_VALUE_(x)

1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION MAJOR,MINOR,PATCH,0
PRODUCTVERSION MAJOR,MINOR,PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Patina"
            VALUE "ProductName", "Patina"
            VALUE "OriginalFilename", "patina.exe"
            VALUE "FileVersion", STRING_VALUE(VERSION_TEXT)
            VALUE "ProductVersion", STRING_VALUE(VERSION_TEXT)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
